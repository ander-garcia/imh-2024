  {
    "id": "agrupar",
    "type": "function",
    "z": "tab_qc",
    "name": "Agrupar pieza",
    "func": "// Junta los 4 valores OPC UA de una pieza en un mensaje MQTT.\n// OPC UA solo notifica cambios: Cota_mm y Resultado pueden no llegar si repiten valor,\n// así que se guarda su último valor. Contador e Imagen cambian en cada pieza: cuando han\n// llegado los dos, se espera 300 ms (por si cota/resultado vienen en el mismo lote) y se publica.\nconst t = msg.topic || \"\";\nconst s = context.get(\"s\") || { nuevoCnt: false, nuevaImg: false };\nif (t.endsWith(\"Cota_mm\")) s.cota = Number(msg.payload);\nelse if (t.endsWith(\"Resultado\")) s.resultado = Number(msg.payload);\nelse if (t.endsWith(\"Contador\")) { s.pieza = Number(msg.payload); s.nuevoCnt = true; }\nelse if (t.endsWith(\"Imagen\")) {\n    const v = msg.payload;\n    s.imagen = Buffer.isBuffer(v) ? v : Buffer.from(v);\n    s.nuevaImg = true;\n}\nelse return null;\ncontext.set(\"s\", s);\n\nif (s.nuevoCnt && s.nuevaImg) {\n    clearTimeout(context.get(\"timer\"));\n    context.set(\"timer\", setTimeout(() => {\n        s.nuevoCnt = false;\n        s.nuevaImg = false;\n        node.send({\n            payload: {\n                time: new Date().toISOString(),\n                pieza: s.pieza,\n                cota_mm: s.cota,\n                resultado: s.resultado,\n                imagen: s.imagen.toString(\"base64\")\n            }\n        });\n        node.status({ fill: s.resultado === 1 ? \"green\" : \"red\", shape: \"dot\", text: `pieza ${s.pieza}` });\n    }, 300));\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "clearTimeout(context.get(\"timer\"));",
    "libs": [],
    "x": 770,
    "y": 400,
    "wires": [
      [
        "mqtt_out_qc"
      ]
    ]
  },
