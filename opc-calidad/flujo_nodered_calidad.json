  {
    "id": "fila_qc",
    "type": "function",
    "z": "tab_qc_db",
    "name": "Preparar fila",
    "func": "// Mensaje MQTT de una pieza -> parámetros del INSERT en la tabla calidad.\nconst p = msg.payload;\nif (!p || typeof p !== \"object\" || p.pieza === undefined) {\n    node.warn(\"Mensaje de calidad no válido\");\n    return null;\n}\nmsg.params = [\n    p.time ? new Date(p.time) : new Date(),\n    p.pieza,\n    p.cota_mm,\n    p.resultado,\n    p.imagen ? Buffer.from(p.imagen, \"base64\") : null\n];\nnode.status({ fill: p.resultado === 1 ? \"green\" : \"red\", shape: \"dot\", text: `pieza ${p.pieza}` });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 120,
    "wires": [
      [
        "pg_insert"
      ]
    ]
  },
  {
    "id": "pg_insert",
    "type": "postgresql",
    "z": "tab_qc_db",
    "name": "Guardar en tabla calidad",
    "query": "INSERT INTO calidad (\"time\", pieza, cota_mm, resultado, imagen)\nVALUES ($1, $2, $3, $4, $5);",
    "postgreSQLConfig": "pg_calidad",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 560,
    "y": 120,
    "wires": [
      []
    ]
  },
  {
    "id": "route",
    "type": "function",
    "z": "tab_qc",
    "name": "Enrutar por nodo",
    "func": "// Salidas: 1 imagen, 2 cota numérica (gauge + gráfico), 3 cota como texto, 4 resultado, 5 contador\nconst t = msg.topic || \"\";\nconst v = msg.payload;\nif (t.endsWith(\"Imagen\")) {\n    const b = Buffer.isBuffer(v) ? v : Buffer.from(v);\n    return [{ payload: \"data:image/png;base64,\" + b.toString(\"base64\") }, null, null, null, null];\n}\nif (t.endsWith(\"Cota_mm\")) {\n    const cota = Number(v);\n    return [null, { payload: Math.round(cota * 1000) / 1000, topic: \"Cota\" }, { payload: cota.toFixed(3) + \" mm\" }, null, null];\n}\nif (t.endsWith(\"Resultado\")) return [null, null, null, { payload: Number(v) }, null];\nif (t.endsWith(\"Contador\"))  return [null, null, null, null, { payload: Number(v) }];\nreturn null;",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 770,
    "y": 200,
    "wires": [
      [
        "t_img"
      ],
      [
        "g_cota",
        "ch_cota"
      ],
      [
        "tx_cota"
      ],
      [
        "t_ok"
      ],
      [
        "tx_cnt"
      ]
    ]
  },
